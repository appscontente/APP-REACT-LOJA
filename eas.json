{
  "cli": {
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://loja-casacontente.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://loja-casacontente.onrender.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://loja-casacontente.onrender.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "PREENCHER-ID-DO-APP-NO-APP-STORE-CONNECT",
        "appleTeamId": "PREENCHER-TEAM-ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-conta-de-servico.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
