{
  "expo": {
    "name": "Casa Contente",
    "slug": "casa-contente",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "casacontente",
    "userInterfaceStyle": "light",
    "backgroundColor": "#faf8f5",
    "ios": {
      "bundleIdentifier": "br.com.casacontente.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:casacontente.com.br",
        "applinks:www.casacontente.com.br",
        "applinks:loja-casacontente.onrender.com"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "A câmera lê o QR code das etiquetas e o código de barras dos produtos na loja."
      }
    },
    "android": {
      "package": "br.com.casacontente.app",
      "adaptiveIcon": {
        "backgroundColor": "#d71921",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "casacontente.com.br"
            },
            {
              "scheme": "https",
              "host": "www.casacontente.com.br"
            },
            {
              "scheme": "https",
              "host": "loja-casacontente.onrender.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "A câmera lê o QR code das etiquetas e o código de barras dos produtos na loja.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "A localização serve para o app dar boas-vindas quando você chega numa loja Casa Contente. Ela fica só no celular.",
          "locationAlwaysAndWhenInUsePermission": "Com o app fechado, a localização serve para avisar quando você passar 2 minutos numa loja Casa Contente. Ela fica só no celular e você desliga na Conta.",
          "locationAlwaysPermission": "Com o app fechado, a localização serve para avisar quando você passar 2 minutos numa loja Casa Contente. Ela fica só no celular e você desliga na Conta.",
          "locationFullAccuracyPermission": "A localização exata serve para saber se você está dentro de uma loja Casa Contente. Ela fica só no celular.",
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#d71921"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#d71921",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
