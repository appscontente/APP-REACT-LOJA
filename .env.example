# Endereço do site que o app lê (rotas /api/app/*). Sem esta variável, o app usa o site publicado no Render.
# No computador, com a loja rodando: EXPO_PUBLIC_SITE_URL=http://localhost:3000
# No celular com o Expo Go, use o IP do computador na rede (ex. http://192.168.0.10:3000).
EXPO_PUBLIC_SITE_URL=https://loja-casacontente.onrender.com
